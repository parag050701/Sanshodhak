# ─────────────────────────────────────────────────────────────────────────────
# Sanshodhak Configuration — API Keys & Credentials
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual credentials
# Keep .env out of version control

# ─── Paper Ingestion APIs ────────────────────────────────────────────────────
# OpenAlex (no key required, but email appreciated for polite pool)
OPENALEX_EMAIL=your-email@research.org

# Semantic Scholar (optional; improves rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# CORE (recommended for better coverage)
CORE_API_KEY=

# PubMed/NCBI (optional; 10 req/s with key, 3 req/s without)
NCBI_API_KEY=

# Unpaywall (required for OA enrichment)
UNPAYWALL_EMAIL=your-email@research.org

# ─── OpenAIRE OAI-PMH ────────────────────────────────────────────────────────
# Optional custom OAI-PMH base URL for OpenAIRE or compatible repository
OPENAIRE_OAI_BASE_URL=

# ─── LLM / Generation APIs ───────────────────────────────────────────────────
# OpenRouter (for question generation, multiple model access)
OPENROUTER_API_KEY=

# NVIDIA NIM (local or cloud endpoint for generation)
NIM_API_BASE_URL=http://localhost:8000
NIM_API_KEY=

# Local Ollama (if using local generation)
OLLAMA_BASE_URL=http://localhost:11434

# ─── Embedding & Vector Store ────────────────────────────────────────────────
# FAISS index configuration
FAISS_INDEX_DIR=./indexes
FAISS_BATCH_SIZE=256

# ─── Evaluation & Logging ────────────────────────────────────────────────────
# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ─── System ──────────────────────────────────────────────────────────────────
# Working directory for ingestion & processing
WORK_DIR=./work
DATA_DIR=./data
CACHE_DIR=./cache

# Number of parallel workers for ingestion/download
MAX_WORKERS=5

# PDF download timeout (seconds)
PDF_DOWNLOAD_TIMEOUT=30
